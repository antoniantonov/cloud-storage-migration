# Reference only: the runners do not automatically load or execute this file.
# Export these variables in your shell. Never put real credentials in git.
MICROSOFT_CLIENT_ID=your-registered-microsoft-public-client-id
GOOGLE_CLIENT_CREDENTIALS_FILE=/absolute/path/to/google-desktop-client.json

# Optional runtime settings (relative host paths are resolved from the repo).
AUTH_DIR=.auth
TEMP_COPY_DIR=temp-copy
AUTH_INTERACTIVE=true
GOOGLE_OAUTH_PORT=8765
DOCKER_IMAGE=cloud-storage-migration:latest

# Set exactly one action when not using command-line action flags.
LIST_ALL=false
COPY_ITEM_IDS=[]
